node Constant {
    name: "Constant";
    description: "Outputs a constant scalar value.";
    tags: ["operator", "constant", "scalar"];
    params: [
        { name: "value", type: "scalar", default: 0.0 }
    ];
    outputs: [
        { name: "field", type: "scalar" }
    ];

    let value = 0.0;

    fn eval(ctx) {
        return value;
    }
};
