import "Constant";

node Add {
    name: "Add";
    description: "Adds the outputs of two scalar input nodes.";
    tags: ["operator", "add", "math", "scalar"];
    inputs: [
        { name: "a", type: "point_scalar" },
        { name: "b", type: "point_scalar" }
    ];
    outputs: [
        { name: "field", type: "point_scalar" }
    ];

    let a = Constant {};
    let b = Constant {};

    fn eval(ctx) {
        return a.eval(ctx) + b.eval(ctx);
    }
};
