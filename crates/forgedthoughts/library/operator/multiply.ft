import "Constant";

node Multiply {
    name: "Multiply";
    description: "Multiplies a scalar input node by a factor.";
    tags: ["operator", "multiply", "math", "scalar"];
    inputs: [
        { name: "input", type: "scalar" }
    ];
    params: [
        { name: "factor", type: "scalar", default: 1.0 }
    ];
    outputs: [
        { name: "field", type: "scalar" }
    ];

    let input = Constant {};
    let factor = 1.0;

    fn eval(ctx) {
        return input.eval(ctx) * factor;
    }
};
